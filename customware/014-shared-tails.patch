+int32_t server_prompt_cache::split_point(const server_tokens & tokens, const server_prefix_holders & holders, int32_t id_self, const server_prefix_holder ** holder, const server_prompt_cache_state ** segment) const {
+    *holder  = nullptr;
+    *segment = nullptr;
+
+    if (tail_min() <= 0) {
+        return 0;
+    }
+
+    int32_t best = 0;
+
+    for (const auto & h : holders) {
+        if (h.id == id_self || h.tokens == nullptr) {
+            continue;
+        }
+        const int32_t c = std::min<int32_t>(h.n_tokens, (int32_t) h.tokens->get_common_prefix(tokens));
+        if (c > best) {
+            best    = c;
+            *holder = &h;
+        }
+    }
+
+    for (const auto & state : states) {
+        if (!state.segment) {
+            continue;
+        }
+        const int32_t c = std::min<int32_t>((int32_t) state.prompt.tokens.size(), (int32_t) state.prompt.tokens.get_common_prefix(tokens));
+        if (c > best) {
+            best     = c;
+            *holder  = nullptr;
+            *segment = &state;
+        }
+    }
+
+    if (best < tail_min()) {
+        *holder  = nullptr;
+        *segment = nullptr;
+        return 0;
+    }
+
+    // review fix: the windows and the re-attach are in positions, and a media chunk before the split takes fewer
+    // positions than tokens under M-RoPE: such a conversation is saved whole
+    if (tokens.pos_next(best) != best) {
+        *holder  = nullptr;
+        *segment = nullptr;
+        return 0;
+    }
+
+    if (*segment == nullptr) {
+        *segment = find_segment(tokens, best);
+    }
+
+    return best;
+}
